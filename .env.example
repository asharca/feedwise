# Database
DATABASE_URL=postgresql://feedwise:password@localhost:5432/feedwise

# Redis
REDIS_URL=redis://localhost:6379

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=https://feedwise.yourdomain.com

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Feedwise <noreply@feedwise.app>

# ─── MCP Server (optional) ───────────────────────────────────
# Email of the user whose data the MCP server should access
# FEEDWISE_USER_EMAIL=your@email.com

# Required: 32-byte key (base64-encoded) used to encrypt secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Dev-only password-less user switcher. Set to 1 in local dev to enable the
# floating "dev login" panel. MUST stay unset/0 in production.
ENABLE_DEV_LOGIN=0
