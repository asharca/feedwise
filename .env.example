# Database
DATABASE_URL=postgresql://feedwise:password@localhost:5432/feedwise

# Redis
REDIS_URL=redis://localhost:6379

# Public origin of this deployment (used for absolute links: digests, shared RSS, client API URLs)
NEXT_PUBLIC_APP_URL=https://feedwise.yourdomain.com

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=https://feedwise.yourdomain.com

# Required: 32-byte key (base64-encoded) used to encrypt secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Fallback SMTP for digest emails when a user hasn't configured their own
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Feedwise <noreply@feedwise.app>

# Hot lists upstream: "dailyhot" (imsyy/DailyHotApi) or "newsnow" (newsnext/newsnow).
# Docker production defaults to http://dailyhot-api:6688.
HOT_API_PROVIDER=dailyhot
HOT_API_URL=http://localhost:6688

# RSSHub instance used by the Discover page
RSSHUB_BASE_URL=https://rsshub.app

# Browser push notifications (optional). Generate a key pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server-side fetches of feed/user-supplied URLs refuse private and loopback
# addresses (SSRF protection). Set to 1 ONLY for local development against
# feeds served from your own machine or LAN.
ALLOW_PRIVATE_NETWORK_FETCH=0

# MCP over stdio (`pnpm mcp`): the user whose data the server acts on.
# FEEDWISE_USER_EMAIL=your@email.com

# Dev-only password-less user switcher. Set to 1 in local dev to enable the
# floating "dev login" panel. MUST stay unset/0 in production.
ENABLE_DEV_LOGIN=0

# ─── docker-compose.yml only ─────────────────────────────────
# FEEDWISE_DB_PASSWORD=
# FEEDWISE_AUTH_SECRET=
# FEEDWISE_ENCRYPTION_KEY=
# ROOT_DOMAIN=yourdomain.com
# TZ=Asia/Shanghai
